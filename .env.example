NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica

# Protege /api/cron/*: a Vercel envia "Authorization: Bearer <CRON_SECRET>"
# automaticamente nas chamadas que ela mesma dispara. Gere um valor aleatório
# (ex.: openssl rand -hex 32) e configure o mesmo valor nas Environment
# Variables do projeto na Vercel.
CRON_SECRET=

# Chave service-role (Supabase > Project Settings > API). Usada SÓ pelo cron
# (/api/cron/*), que roda sem usuário logado — o role anon não tem acesso às
# tabelas. É SECRETA: ignora RLS e GRANTs. Nunca prefixar com NEXT_PUBLIC_ e
# configurar apenas nas Environment Variables da Vercel (server-side).
SUPABASE_SERVICE_ROLE_KEY=

# Notificacoes por e-mail (novo contrato) via Gmail SMTP — SO servidor.
# GMAIL_APP_PASSWORD e uma Senha de App do Google (exige verificacao em 2 etapas),
# NAO a senha da conta. Configure na Vercel (Production) e faca redeploy.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=ROMABC ONE
# Opcional: base dos links "Abrir no painel" (padrao: https://plataforma-romabc.vercel.app).
APP_URL=
